generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model RoastResult {
  id         String   @id @default(cuid())
  url        String
  score      Int
  roast      String
  suggestion String
  mode       String   @default("roast")
  screenshot String?
  createdAt  DateTime @default(now())
}
